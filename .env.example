# ── Skinnor · variables de entorno ──────────────────────────────────────────
# Copiar este archivo como `.env` y completar los valores.
# El archivo `.env` real NUNCA se commitea.

# FastAPI · servicio de análisis de imagen y embeddings (Derm Foundation)
# URL local del servicio Python (main.py) — no requiere API key.
FASTAPI_EMBED_URL=http://127.0.0.1:8080
FASTAPI_TIMEOUT_MS=120000

# Pinecone · índice vectorial para "buscar casos similares"
# Obtener en https://app.pinecone.io → API Keys. El HOST es el endpoint
# del índice (ej. tu-indice-xxxx.svc.us-east-1.pinecone.io, sin https://).
PINECONE_API_KEY=
PINECONE_HOST=
PINECONE_INDEX=skin222
PINECONE_TOP_K=12
PINECONE_TIMEOUT_MS=30000

# HAM10000 · carpeta local del dataset (debe contener
# HAM10000_images_part_1/ y HAM10000_images_part_2/).
# Si no se define, el servidor usa C:\Users\<usuario>\Downloads\HAM10000
HAM_IMAGES_DIR=

# Python · ruta a la carpeta local del modelo google/derm-foundation
# (la que contiene saved_model.pb). Si se deja vacío, main.py descarga
# el modelo desde Hugging Face al cache local.
# Ejemplo Windows: DERM_MODEL_PATH=C:\Users\mati1\Skinnor\googlederm
DERM_MODEL_PATH=
